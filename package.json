{
  "name": "react-native-dynamic-search-bar",
  "version": "2.0.2",
  "description": "Fully customizable and dynamic Search Bar for React Native.",
  "keywords": [
    "react-native",
    "ios",
    "android",
    "expo",
    "search",
    "search-bar",
    "searchbar",
    "dynamic-search-bar",
    "input",
    "textinput",
    "ui",
    "ui-component",
    "ui-lib",
    "dark-mode",
    "freakycoder",
    "kuray"
  ],
  "homepage": "https://github.com/kuraydev/react-native-dynamic-search-bar#readme",
  "bugs": {
    "url": "https://github.com/kuraydev/react-native-dynamic-search-bar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraydev/react-native-dynamic-search-bar.git"
  },
  "author": "Kuray (FreakyCoder) <kurayogun@gmail.com>",
  "license": "MIT",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__mocks__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "clean": "del-cli lib",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "@freakycoder/react-native-bounceable": ">=0.2.2",
    "react-native-spinkit": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "react-native-spinkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.9.0",
    "@freakycoder/react-native-bounceable": "^1.0.3",
    "@react-native/babel-preset": "0.75.2",
    "@testing-library/react-native": "^12.5.3",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.3",
    "@types/react-test-renderer": "^18.3.0",
    "del-cli": "^5.1.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "react": "18.3.1",
    "react-native": "0.75.2",
    "react-native-builder-bob": "^0.30.0",
    "react-native-spinkit": "^1.5.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  },
  "jest": {
    "preset": "react-native",
    "roots": [
      "<rootDir>/src"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/example/",
      "/lib/"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?@react-native|react-native|@freakycoder|react-native-spinkit|@testing-library)"
    ]
  }
}
